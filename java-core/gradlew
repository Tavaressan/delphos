#!/usr/bin/env bash
#
# Gradle Wrapper script
# Generated by Gradle Wrapper 9.5.1
#
# This script allows a project to be built with a specific Gradle version without installing it manually.
# It downloads the Gradle distribution if not already present in the wrapper directory.
#
# Usage: ./gradlew [task] [...]

# Resolve location of this script
SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
GRADLE_WRAPPER_DIR="$SCRIPT_DIR/gradle/wrapper"
GRADLE_JAR="$GRADLE_WRAPPER_DIR/gradle-wrapper.jar"

# Load properties
PROPERTIES_FILE="$GRADLE_WRAPPER_DIR/gradle-wrapper.properties"
if [[ ! -f "$PROPERTIES_FILE" ]]; then
  echo "Gradle wrapper properties not found: $PROPERTIES_FILE"
  exit 1
fi

# Read distribution URL from properties
DIST_URL=$(grep '^distributionUrl=' "$PROPERTIES_FILE" | cut -d'=' -f2-)
if [[ -z "$DIST_URL" ]]; then
  echo "distributionUrl not defined in wrapper properties"
  exit 1
fi

# Determine gradle home directory (cache)
GRADLE_USER_HOME="${GRADLE_USER_HOME:-$HOME/.gradle}"
GRADLE_DIST_DIR="$GRADLE_USER_HOME/wrapper/dists"

# Resolve the zip file name from URL
ZIP_NAME=$(basename "$DIST_URL")
ZIP_DIR_NAME="${ZIP_NAME%.*}"
DIST_DIR="$GRADLE_DIST_DIR/$ZIP_DIR_NAME"

# If distribution not present, download it
if [[ ! -d "$DIST_DIR" ]]; then
  echo "Downloading Gradle distribution ($DIST_URL)..."
  mkdir -p "$GRADLE_DIST_DIR"
  TMP_ZIP="/tmp/$ZIP_NAME"
  curl -L -o "$TMP_ZIP" "$DIST_URL"
  mkdir -p "$DIST_DIR"
  unzip -q "$TMP_ZIP" -d "$DIST_DIR"
  rm -f "$TMP_ZIP"
fi

# Resolve Gradle binary inside the distribution
GRADLE_BIN="$DIST_DIR/gradle-$ZIP_DIR_NAME/bin/gradle"
if [[ ! -x "$GRADLE_BIN" ]]; then
  echo "Gradle binary not found or not executable: $GRADLE_BIN"
  exit 1
fi

# Execute Gradle with any arguments passed to the wrapper
exec "$GRADLE_BIN" "$@"
