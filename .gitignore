# OS
.DS_Store
Thumbs.db

# Node
# Sem barra final: pega diretórios E outros tipos de entrada (ex.: symlinks)
# nomeados node_modules em qualquer profundidade — evita repetição do
# incidente em que um symlink node_modules->/caminho/local/absoluto escapou
# do gitignore (padrão com barra só casa diretórios) e foi commitado (#235).
node_modules
.next/
dist/
.env.local
.env.*.local
npm-debug.log*
yarn-debug.log*
yarn-error.log*
*.tsbuildinfo

# Java
.gradle/
build/
out/
bin/
*.class
*.jar
# EXCEÇÃO: Permite explicitamente o JAR essencial do Gradle Wrapper
!java-core/gradle/wrapper/gradle-wrapper.jar
*.war
*.ear

# Rust
target/
# Cargo.lock é ignorado globalmente, mas o workspace de binários deve ter o lock comitado.
# A exceção abaixo garante que rust-services/Cargo.lock seja rastreado.
Cargo.lock
!rust-services/Cargo.lock

# IDEs
.idea/
.vscode/
*.iml
*.swp
*.swo

#Extension de arquivos de log
.VSCodeCounter/

# Docker
*.log
.env
.env.ci-runner

# Bloqueio absoluto de chaves de nuvem
infrastructure/gcp/*.json


# Python
.venv/
__pycache__/
*.pyc
test_models.py

# Agents
.agents/

# Força a normalização de quebras de linha para LF em qualquer sistema operacional
* text=auto eol=lf

# Mantém arquivos binários intactos
*.jar binary
*.png binary

# Impede que arquivos de worktrees do Claude Code sejam rastreados
.claude/worktrees/

# Arquivo de status de scratch usado por sub-agentes do coordinator (Vetor) —
# nunca deve ser versionado, sob risco de sobrescrever o status de outros
# workers ao fazer merge/rebase de master
AGENT_STATUS.md
.claude/vetor/status/
