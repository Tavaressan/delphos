# Example environment variables for local development

# PostgreSQL
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=rag_db

# JWT secret (change to a strong random value)
JWT_SECRET=changeme_secure_random_string

# MinIO credentials
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin

# Backend configuration
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000

# Frontend configuration (used by Next.js)
NEXT_PUBLIC_BACKEND_URL=http://localhost:8000

# Caddy Reverse Proxy & DuckDNS Configuration
DOMAIN_NAME=seu-projeto.duckdns.org
DUCKDNS_TOKEN=seu_token_aqui



# GCP Authentication & Vertex AI
GOOGLE_APPLICATION_CREDENTIALS=/app/credentials/gcp-key.json
GCP_PROJECT_ID=alfabra-platform
GCP_LOCATION=us-central1
GCP_CHAT_MODEL_ID=gemini-1.5-flash-002
GCP_RAG_MODEL_ID=text-embedding-004


