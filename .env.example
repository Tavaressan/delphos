# Example environment variables for local development

# PostgreSQL
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=rag_db

# JWT secret (change to a strong random value)
JWT_SECRET=changeme_secure_random_string

# MinIO credentials
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin

# Backend configuration
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000

# Frontend configuration (used by Next.js)
NEXT_PUBLIC_BACKEND_URL=http://localhost:8000

# Caddy Reverse Proxy & DuckDNS Configuration
DOMAIN_NAME=seu-projeto.duckdns.org
DUCKDNS_TOKEN=seu_token_aqui



# GCP Authentication & Vertex AI
#
# Passo 1 — Autenticar com o Google Cloud (apenas uma vez por máquina):
#   gcloud auth application-default login
#
# Passo 2 — Validar credenciais antes de subir a stack:
#   ./scripts/check-gcp.sh
#
# GOOGLE_APPLICATION_CREDENTIALS é mapeado automaticamente pelo docker-compose.yml para /gcloud/adc.json
# ADC_PATH deve apontar para o arquivo gerado pelo comando acima:
#   macOS/Linux: ADC_PATH=$HOME/.config/gcloud/application_default_credentials.json
#   Windows:     ADC_PATH=C:/Users/<usuario>/AppData/Roaming/gcloud/application_default_credentials.json
GOOGLE_APPLICATION_CREDENTIALS=/gcloud/adc.json
ADC_PATH=/caminho/para/application_default_credentials.json
GCP_PROJECT_ID=alfabra-platform
GCP_LOCATION=us-central1
GCP_CHAT_MODEL_ID=gemini-3.6-flash
GCP_RAG_MODEL_ID=gemini-embedding-001

# Cadeia de LLM do crew-worker (crewai_adapter.py), da esquerda para a direita —
# issue #389, decisão de 2026-08-19: Google AI Studio é o PRIMÁRIO; Vertex AI é o
# ÚLTIMO elo de fallback (não foi removido — só deixou de ser primário porque seu
# free tier está expirado, ver #192/#193/#194, e cada chamada paga o custo de uma
# tentativa fadada ao 404 antes de cair para o AI Studio). Um elo Ollama entra no
# meio dessa cadeia futuramente (issue #358).
#   AI Studio (primário) -> [Ollama, issue #358] -> Vertex AI (último fallback)
GOOGLE_AI_STUDIO_API_KEY=seu_token_google_ai_studio
# Modelo usado no ramo Google AI Studio do crew-worker. Default no código também é
# gemini-3.6-flash caso esta var não seja definida — mantenha os dois em sincronia
# (issue #389: gemini-1.5-flash foi aposentado).
GOOGLE_AI_STUDIO_CHAT_MODEL_ID=gemini-3.6-flash

# Modo do crew-worker: "real" (padrão) usa Google AI Studio, com fallback para Ollama (se
# configurado) e, por último, Vertex AI; "mock" ativa MockLLM para dev local sem GCP; "ollama"
# usa Ollama diretamente (dev/teste com semântica real, sem credencial GCP — requer
# OLLAMA_CHAT_MODEL).
# CREW_WORKER_MODE=mock

# IMPORTANTE: variáveis de env_file (como as acima) são lidas apenas na CRIAÇÃO do container —
# editar o .env não afeta containers já criados. `docker compose up -d` sozinho NÃO detecta essa
# mudança e não recria o container. Depois de editar qualquer var deste arquivo, rode:
#   docker compose up -d --force-recreate <serviço>
# ou use ./scripts/dev.sh, que já roda com --force-recreate (issue #389).

# Modo de embeddings (embedding-service/ingestion-worker): "real" (padrão) usa Vertex AI, com
# fallback para Google AI Studio; "mock" retorna vetores determinísticos, sem chamadas externas;
# "ollama" usa o Ollama local (ver seção abaixo).
# EMBEDDING_PROVIDER=mock

# Cadeia de fallback do embedding-service, da esquerda para a direita — issue #428:
#   Vertex AI (ADC) -> Google AI Studio (GOOGLE_AI_STUDIO_API_KEY) -> VoyageAI (VOYAGE_API_KEY)
# VoyageAI é opcional: sem VOYAGE_API_KEY configurada, esse elo é simplesmente pulado.
# ATENÇÃO: nenhum modelo VoyageAI produz nativamente 768 dimensões (a dimensão padrão do schema
# pgvector, EMBEDDING_DIMENSIONS/embedding.dimension) — os modelos flexíveis (voyage-3.5-lite
# incluso) só suportam output_dimension em {256, 512, 1024, 2048}. Se as dimensões não baterem
# com o schema, o embedding-service falha explicitamente em vez de gravar um vetor incompatível.
# VOYAGE_API_KEY=seu_token_voyageai
# VOYAGE_MODEL=voyage-3.5-lite

# Modo de geração do rag-worker: "real" (padrão) usa a cadeia Google AI Studio -> Ollama (este
# último só entra se OLLAMA_CHAT_MODEL estiver configurado) -> Vertex AI para a resposta final
# do chat; "mock" retorna uma resposta mockada, mantendo real a busca vetorial no Postgres.
# LLM_PROVIDER=mock

# Ollama — provider local de embeddings e chat (issue #358).
#
# Papel: redundância além do Google (Vertex AI e AI Studio são o mesmo fornecedor) e camada de
# teste com semântica real. NÃO substitui os providers Google em produção — a ordem de fallback
# é AI Studio -> Ollama -> Vertex AI (issue #389: Vertex por último por ter o free tier
# expirado).
#
# Requer subir o serviço `ollama` do docker-compose.yml, que fica fora do profile default (o
# pull dos modelos é de vários GB):
#   docker compose --profile local-ai up -d
#   docker compose --profile local-ai exec ollama ollama pull nomic-embed-text
#   docker compose --profile local-ai exec ollama ollama pull llama3.2
#
# OLLAMA_BASE_URL: default http://ollama:11434 (nome do serviço no compose); ajuste para
# http://localhost:11434 ao rodar um serviço fora do Docker contra um Ollama já instalado.
# OLLAMA_EMBEDDING_MODEL: nomic-embed-text produz 768 dimensões, compatível com o schema
# pgvector atual (document_chunks.embedding vector(768), ver EMBEDDING_DIMENSIONS abaixo). Ao
# trocar de modelo, confirme a dimensão de saída antes de usar em produção.
# OLLAMA_CHAT_MODEL: sem valor, o fallback para Ollama no rag-worker e no crew-worker fica
# desativado (opt-in), para não tentar alcançar um host Ollama que pode não existir.
# OLLAMA_BASE_URL=http://ollama:11434
# OLLAMA_EMBEDDING_MODEL=nomic-embed-text
# OLLAMA_CHAT_MODEL=llama3.2


