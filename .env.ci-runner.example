# A GitHub App private key (PEM) é multilinha e não é passada via este
# arquivo .env — é exportada diretamente do arquivo original antes do
# `docker compose up` (ver instruções no topo de docker-compose.ci-runner.yml):
#
#   export GH_RUNNER_APP_PRIVATE_KEY="$(cat /caminho/para/sua-app.private-key.pem)"
#
# APP_ID e APP_LOGIN não são segredos (o segredo é só a private key) e por
# isso já estão hardcoded no docker-compose.ci-runner.yml.
